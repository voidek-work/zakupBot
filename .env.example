# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zakup_bot?schema=public"

# Default Manager / Admin Telegram IDs (comma separated if multiple)
MANAGER_TELEGRAM_IDS=123456789,987654321
DIRECTOR_TELEGRAM_IDS=123456789

# Approval threshold (e.g. 200 GEL - above this director approval is triggered)
APPROVAL_THRESHOLD_GEL=200

# Google Sheets Integration
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Use escaped newlines \n for private key or paste multiline key
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron Schedules (Timezone: Europe/Moscow)
CRON_WEEKLY_DIGEST="0 10 * * 1"       # Every Monday at 10:00 AM (Digest of planned requests)
CRON_REGULAR_CHECKLIST="0 16 * * 5"    # Every Friday at 16:00 (Inventory of consumables)
